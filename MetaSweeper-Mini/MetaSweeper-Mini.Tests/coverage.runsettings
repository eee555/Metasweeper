<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <Include>[MetaSweeper-Mini.Tests]ReplayChecksum</Include>
          <Include>[MetaSweeper-Mini.Tests]GameSettings</Include>
          <Include>[MetaSweeper-Mini.Tests]IniFile</Include>
          <Include>[MetaSweeper-Mini.Tests]LocalFiles</Include>
          <Include>[MetaSweeper-Mini.Tests]ShortcutCatalog</Include>
          <Exclude>[MetaSweeper-Mini.Tests]ReplayChecksumTests</Exclude>
          <Exclude>[MetaSweeper-Mini.Tests]ReplayChecksumEdgeTests</Exclude>
          <Exclude>[MetaSweeper-Mini.Tests]GameSettingsTests</Exclude>
          <ExcludeByFile>**/ReplayChecksumTests.cs,**/ReplayChecksumEdgeTests.cs,**/GameSettingsTests.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
