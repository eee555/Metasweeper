<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <ProjectGuid>{ABFD08BC-FD0E-4598-827D-DE281CD90D5A}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <StartupObject>Program</StartupObject>
    <RootNamespace>MetaSweeperMini</RootNamespace>
    <AssemblyName>MetaSweeper-Mini</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>5</LangVersion>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <ApplicationIcon>..\..\src\media\cat.ico</ApplicationIcon>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x64\$(Configuration)\</IntermediateOutputPath>
    <StartAction>Project</StartAction>
    <StartWorkingDirectory>$(MSBuildProjectDirectory)</StartWorkingDirectory>
    <NativeResources>$(MSBuildProjectDirectory)\obj\resources</NativeResources>
    <NativeWorkspace>$(MSBuildProjectDirectory)\obj\native</NativeWorkspace>
    <OfflineArgument Condition="'$(ResourceOffline)' == 'true'">-Offline</OfflineArgument>
    <PythonArgument Condition="'$(PythonPath)' != ''">-PythonPath &quot;$(PythonPath)&quot;</PythonArgument>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Compile Include="Program.cs" />
    <Compile Include="Configuration\AutoSaveMode.cs" />
    <Compile Include="Configuration\BoardPreset.cs" />
    <Compile Include="Configuration\BoardPixels.cs" />
    <Compile Include="Configuration\Countries.cs" />
    <Compile Include="Configuration\GameSettings.cs" />
    <Compile Include="Configuration\IniFile.cs" />
    <Compile Include="Configuration\LocalFiles.cs" />
    <Compile Include="Configuration\ShortcutCatalog.cs" />
    <Compile Include="Configuration\UiText.cs" />
    <Compile Include="Game\Game.cs" />
    <Compile Include="Game\ReplayFilename.cs" />
    <Compile Include="Game\ReplayChecksum.cs" />
    <Compile Include="Native\NativeCore.cs" />
    <Compile Include="Native\NativeTypes.cs" />
    <Compile Include="UI\BoardView.cs" />
    <Compile Include="UI\BoardLayout.cs" />
    <Compile Include="UI\ClassicFrame.cs" />
    <Compile Include="UI\ClassicSprites.cs" />
    <Compile Include="UI\CounterWindow.cs" />
    <Compile Include="UI\CursorLock.cs" />
    <Compile Include="UI\DisplayPanel.cs" />
    <Compile Include="UI\DisplayRefresh.cs" />
    <Compile Include="UI\FaceButton.cs" />
    <Compile Include="UI\GameShortcuts.cs" />
    <Compile Include="UI\GameWindow.cs" />
    <Compile Include="UI\IdentityFooter.cs" />
    <Compile Include="UI\SettingsDialog.cs" />
    <Compile Include="UI\UiPulse.cs" />
    <None Include="Native\native.rs;build.ps1;Build\prepare-resources.ps1;Build\build_resources.py;Build\ms-toollib.rev;README.md" />
    <EmbeddedResource Include="$(NativeResources)\mines_core.lzms"><LogicalName>mines_core.lzms</LogicalName><Visible>false</Visible></EmbeddedResource>
    <EmbeddedResource Include="$(NativeResources)\classic-shapes.bin"><LogicalName>classic-shapes.bin</LogicalName><Visible>false</Visible></EmbeddedResource>
    <EmbeddedResource Include="$(NativeResources)\countries.deflate"><LogicalName>countries.deflate</LogicalName><Visible>false</Visible></EmbeddedResource>
    <EmbeddedResource Include="$(NativeResources)\ms_toollib-LICENSE"><LogicalName>ms_toollib-LICENSE</LogicalName><Visible>false</Visible></EmbeddedResource>
  </ItemGroup>

  <Target Name="CollectNativeInputs">
    <ItemGroup>
      <NativeInput Include="$(MSBuildProjectFullPath);Native\native.rs;Build\prepare-resources.ps1;Build\build_resources.py;Build\ms-toollib.rev" />
      <NativeInput Include="..\..\src\country_name.py;..\..\src\media\*.svg" />
    </ItemGroup>
  </Target>

  <Target Name="BuildNativeResources" BeforeTargets="PrepareResourceNames"
          DependsOnTargets="CollectNativeInputs"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(NativeInput)"
          Outputs="$(NativeResources)\mines_core.lzms;$(NativeResources)\classic-shapes.bin;$(NativeResources)\countries.deflate;$(NativeResources)\ms_toollib-LICENSE">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-resources.ps1&quot; -WorkDir &quot;$(NativeWorkspace)&quot; -ResourceDir &quot;$(NativeResources)&quot; $(PythonArgument) $(OfflineArgument)" />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
